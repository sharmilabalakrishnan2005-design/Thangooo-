<!DOCTYPE html>
<html>
<head>
    <title>Akash ❤️</title>

    <style>
        body {
            background: linear-gradient(135deg, #ffd6e7, #ffeef5);
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 50px 20px;
        }

        .box {
            background: white;
            max-width: 600px;
            margin: 30px auto;
            padding: 30px;
            border-radius: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        h1 {
            color: #d6336c;
        }

        p {
            color: #5c3b45;
            font-size: 18px;
            line-height: 1.7;
        }

        input {
            display: block;
            width: 80%;
            max-width: 300px;
            margin: 15px auto;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 20px;
            font-size: 16px;
        }

        button, a {
            display: inline-block;
            background: #d6336c;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            font-weight: bold;
            margin: 8px;
            text-decoration: none;
            cursor: pointer;
        }

        button:hover, a:hover {
            background: #b52b5b;
        }

        #lovePage {
            display: none;
        }

        #error {
            color: red;
            display: none;
        }

        #qrcode {
            margin: 20px auto;
            width: 250px;
        }
    </style>
</head>

<body>

    <!-- LOGIN PAGE -->
    <div class="box" id="loginPage">

        <h1>Only for you ❤️🔐</h1>

        <input
            type="text"
            id="username"
            placeholder="Username">

        <input
            type="password"
            id="password"
            placeholder="Password">

        <button onclick="login()">Login ❤️</button>

        <p id="error">Wrong username or password ❌</p>

    </div>


    <!-- LOVE PAGE -->
    <div class="box" id="lovePage">

        <h1>From school love to forever love. ❤️🫶🏻</h1>

        <p>
            It started as a little school-time feeling, but somehow you became
            my safest place, my favorite person, and the one story I never want
            to end. Years passed, life changed, but my heart still finds its way
            back to you — every single time. ❤️‍🩹✨ love youu more
        </p>

        <!-- SPOTIFY -->
        <a
            href="https://open.spotify.com/track/2MwCoo4GeXpi8soWn9EiPo?si=lhyGhv_nTSitsUGwKTc7dQ&utm_source=copy-link"
            target="_blank">
            🎵 Our Song ❤️
        </a>

        <!-- VIDEO -->
        
        <a
            href="https://www.instagram.com/reel/DakvWLPzGih/?igsh=Y2lyNzB2bXliZTQ0" 
</a>"
            target="_blank">
            🎥 Watch our video ❤️
        </a>

    </div>


    <!-- QR CODE -->
    <div class="box">

        <h2>Scan Me ❤️📱</h2>

        <div id="qrcode"></div>

        <p>Scan this QR code to open our page ❤️</p>

    </div>


    <!-- QR CODE LIBRARY -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <script>

        function login() {

            const username =
                document.getElementById("username").value;

            const password =
                document.getElementById("password").value;

            if (username === "Akash" && password === "@sharmila") {

                document.getElementById("loginPage").style.display = "none";

                document.getElementById("lovePage").style.display = "block";

            } else {

                document.getElementById("error").style.display = "block";

            }
        }


        // YOUR THANGOO WEBSITE LINK
        new QRCode(document.getElementById("qrcode"), {
            text: "https://sharmilabalakrishnan2005-design.github.io/Thangooo-/",
            width: 250,
            height: 250
        });

    </script>

</body>
